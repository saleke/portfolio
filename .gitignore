# secrets — never commit these
.env.local
.env*.local

# dependencies
node_modules/

# build output
.next/
out/
build/

# TypeScript incremental cache. Regenerated by `tsc --noEmit`, and it changes on
# every run, so tracking it produces a noisy diff that means nothing. It was
# committed before it was ignored; `git rm --cached` untracked it.
tsconfig.tsbuildinfo

# Next.js rewrites this file whenever it switches between dev and build, flipping
# the paths it imports. That churn is generated, not authored, and committing it
# buries real changes under a diff nobody made on purpose.
next-env.d.ts

# system files
.DS_Store
*.log

# editor
.vscode/
