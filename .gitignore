# secrets — never commit these
.env.local
.env*.local

# dependencies
node_modules/

# build output
.next/
out/
build/

# TypeScript incremental cache. Regenerated by `tsc --noEmit`, and it changes on
# every run, so tracking it produces a noisy diff that means nothing. It was
# committed before it was ignored; `git rm --cached` untracked it.
tsconfig.tsbuildinfo

# system files
.DS_Store
*.log

# editor
.vscode/
