# Admin control plane — required
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
#
# Generate the two secrets:
#   node scripts/hash-password.mjs "your password"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# scrypt$<saltHex>$<hashHex> — the password for /admin, never stored in plaintext.
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Any long random string. Rotating it logs you out.
ADMIN_SESSION_SECRET=

# --- Publishing — required for the admin to actually save anything ------------
#
# A fine-grained personal access token with `Contents: write` on this repository
# only, and no access to any other repo. Nothing else is needed.

GITHUB_TOKEN=
GITHUB_REPO_OWNER=saleke
GITHUB_REPO_NAME=portfolio

# The branch a save commits to. Defaults to main.
GITHUB_BRANCH=main

# --- Commit attribution — optional --------------------------------------------
#
# Defaults to the GitHub token's owner. Set these to take credit for the commit
# rather than appearing as the token's owner.

# ADMIN_COMMIT_AUTHOR=Solomon Aleke
# ADMIN_COMMIT_EMAIL=saleke@users.noreply.github.com

# --- Contact channels — all optional -----------------------------------------
#
# Deliberately environment variables rather than editable in the admin: a phone
# number and a personal address should not live in a public repository's history.
# A channel with no value here is omitted from the site entirely, so there is no
# dead mailto: or tel: link. The admin settings page shows which are set.

# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_GITHUB_URL=
# NEXT_PUBLIC_CONTACT_LINKEDIN_URL=

# --- Site URL — optional ------------------------------------------------------
#
# Only needed for a custom domain or a non-Vercel host. Vercel supplies
# VERCEL_PROJECT_PRODUCTION_URL, which is used automatically.

# NEXT_PUBLIC_SITE_URL=